{
  "name": "studio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "deploy:self": "bun run ./scripts/self-deploy.ts",
    "compass:deploy": "bun run ./scripts/compass-deploy.ts",
    "fetch:abi": "bun run ./scripts/fetch-abi.ts",
    "lint": "oxlint --type-aware src && oxlint src",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "contracts:build": "node scripts/run-foundry.mjs build --offline",
    "contracts:test": "node scripts/run-foundry.mjs test --offline --summary",
    "test:model": "bun test tests",
    "test:all": "bun test tests && forge test",
    "verify:deployment": "bun run scripts/verify-deployment.ts",
    "e2e:wallets": "bun run scripts/e2e-wallets.ts",
    "e2e:testnet": "bun run scripts/testnet-e2e.ts",
    "e2e:ui": "node tests-ui/run.mjs",
    "test:deploy": "node --test --test-concurrency=1 tests/browser-deploy.test.mjs tests/mainnet-app.test.mjs && node tests-ui/deploy-audit.mjs && node tests-ui/deploy-flow-mock.mjs && node tests-ui/mainnet-app-mock.mjs",
    "test:groups": "node --test tests/group-management.test.mjs && node tests-ui/group-management-mock.mjs",
    "test:pointer": "node tests-ui/group-management-mock.mjs --pointer",
    "mainnet:preflight": "node scripts/mainnet-deploy.mjs",
    "mainnet:verify": "node scripts/mainnet-verify.mjs",
    "mainnet:smoke": "node scripts/mainnet-smoke-test.mjs",
    "deploy:artifact:check": "node scripts/check-deploy-artifact.mjs",
    "build": "node scripts/check-public-config.mjs && node scripts/check-deploy-artifact.mjs && vite build"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.19.2",
    "@circle-fin/app-kit": "^1.18.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@circle-fin/modular-wallets-core": "^1.0.16",
    "@circle-fin/smart-contract-platform": "^10.8.1",
    "@circle-fin/user-controlled-wallets": "^10.8.1",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@openzeppelin/contracts": "5.6.1",
    "@tanstack/react-query": "^5.62.7",
    "@web3icons/react": "^4.0.0",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "2.57.5",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "viem": "2.57.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
